# .env.example - OpenInstaDM
# Copie este arquivo para .env:  copy .env.example .env

# --- BANCO DE DADOS (Docker local) ---
DATABASE_URL="postgresql://postgres.ukldxgepvzfsitpksgqq:q&h&?Z/G3jJqgq9@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
REDIS_URL=redis://localhost:6379

# --- APP ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque_por_openssl_rand_base64_32
CRON_SECRET=troque_por_openssl_rand_base64_32

# --- ENCRIPTAÇÃO (OBRIGATÓRIO - 64 caracteres hex = 32 bytes) ---
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- RESEND (login por e-mail) ---
RESEND_API_KEY=re_sua_chave_do_resend
EMAIL_FROM=noreply@seudominio.com

# --- META / FACEBOOK / INSTAGRAM ---
# Pegue em developers.facebook.com > App Settings > Basic
FACEBOOK_APP_ID=seu_app_id_aqui
FACEBOOK_APP_SECRET=seu_app_secret_aqui

# Instagram - em Instagram > API Setup with Instagram Login
INSTAGRAM_APP_ID=seu_instagram_app_id
INSTAGRAM_APP_SECRET=seu_instagram_app_secret

# Token que você inventou para validar o webhook - tem que bater com o da Meta
WEBHOOK_VERIFY_TOKEN=meu_token_123_gustavo

# Versão da API (deixe como está)
META_GRAPH_API_VERSION=v26.0
